# Copy this file to ".env" (same folder) and fill in the values.
# Do NOT put real secrets in this example file - ".env" itself is git-ignored.

# --- Required ---
# MongoDB connection string, e.g. mongodb://127.0.0.1:27017/jobmarket
DB_URI=
# Long random strings (e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=
JWT_SECRET=

# --- Optional ---
PORT=5000
NODE_ENV=development
# Where the React app runs (used for CORS and OAuth redirects)
CLIENT_URL=http://localhost:5173
# Public URL of this server (used for OAuth callback URLs)
SERVER_URL=http://localhost:5000
# Python skill-prediction service (BackEnd/app.py)
ML_SERVICE_URL=http://localhost:2001
# Set to true when the site is served over HTTPS
COOKIE_SECURE=false

# Resume summaries (skipped if no key is set)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Google / LinkedIn sign-in (the buttons answer "not configured" if these are empty)
Google_Client_ID=
Google_Client_Secret=
LinkedIn_Client_ID=
LinkedIn_Client_Secret=
